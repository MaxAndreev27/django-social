# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

# Python files
[*.py]
indent_style = space
indent_size = 4
max_line_length = 79

# Django templates
[*.html]
indent_style = space
indent_size = 2

# CSS and SCSS
[*.{css,scss}]
indent_style = space
indent_size = 2

# JavaScript and JSON
[*.{js,json}]
indent_style = space
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
indent_style = space
indent_size = 2
max_line_length = 100

# Makefile
[Makefile]
indent_style = tab
